<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 终极科技单位。所有特殊模式、召唤、蓄力和范围技能均暂未实现。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Leo</defName>
    <label>雷奥淳平</label>
    <description>非常强的超重型近战机械体，能够通过细胞重组迅速治愈友军的伤势。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.9</ArmorRating_Blunt>
      <MarketValue>4800</MarketValue>
      <MoveSpeed>4.4</MoveSpeed>
      <!-- 等效近战 20。 -->
      <MeleeHitChance>20</MeleeHitChance>
    </statBases>
    <tools>
      <!-- 主力重拳 -->
      <li>
        <label>雷奥重拳</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
      <!-- 威力极高但比较慢 -->
      <li>
        <label>雷奥重踢</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60</power>
        <cooldownTime>3.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
      <!-- 较快的普通攻击 -->
      <li>
        <label>雷奥掌击</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>32</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <baseBodySize>2.0</baseBodySize>
      <baseHealthScale>3.6</baseHealthScale>
      <mechWeightClass>UltraHeavy</mechWeightClass>
    </race>
    <abilities>
      <li>ChunPing_Ability_CellRecombination</li>
    </abilities>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_Leo</defName>
    <label>雷奥淳平</label>
    <race>Mech_ChunPing_Leo</race>
    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Fabricor</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/FabricorAncient</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <isFighter>true</isFighter>
    <combatPower>650</combatPower>
  </PawnKindDef>


