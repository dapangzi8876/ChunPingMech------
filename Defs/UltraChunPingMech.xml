<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 终极科技单位。所有特殊模式、召唤、蓄力和范围技能均暂未实现。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Leo</defName>
    <label>雷奥淳平</label>
    <description>非常强的超重型近战机械体。范围攻击和特殊技能暂未实现。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.9</ArmorRating_Blunt>
      <MarketValue>4800</MarketValue>
      <MoveSpeed>4.4</MoveSpeed>
      <!-- 等效近战 20。 -->
      <MeleeHitChance>20</MeleeHitChance>
    </statBases>
    <tools>
      <!-- 主力重拳 -->
      <li>
          <label>雷奥重拳</label>
          <capacities>
              <li>Blunt</li>
          </capacities>
          <power>45</power>
          <cooldownTime>2.4</cooldownTime>
          <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
      </li>
      <!-- 威力极高但比较慢 -->
      <li>
          <label>雷奥重踢</label>
          <capacities>
              <li>Blunt</li>
          </capacities>
          <power>60</power>
          <cooldownTime>3.5</cooldownTime>
          <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <!-- 较快的普通攻击 -->
      <li>
          <label>雷奥掌击</label>
          <capacities>
              <li>Blunt</li>
          </capacities>
          <power>32</power>
          <cooldownTime>1.8</cooldownTime>
          <linkedBodyPartsGroup>Hands</linkedBodyPartsGroup>
      </li>
  </tools>
    <race>
      <baseBodySize>2.0</baseBodySize>
      <baseHealthScale>3.6</baseHealthScale>
      <mechWeightClass>UltraHeavy</mechWeightClass>
    </race>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_Leo</defName>
    <label>雷奥淳平</label>
    <race>Mech_ChunPing_Leo</race>
    <isFighter>true</isFighter>
    <combatPower>650</combatPower>
  </PawnKindDef>


  <!-- TODO: 后续加入战争女皇召唤系统；当前仅为中等输出的重型远程单位。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Beelzebub</defName>
    <label>贝尔泽布布淳平</label>
    <description>重型远程或中近距离战斗机械体。召唤系统暂未实现。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
      <MarketValue>4300</MarketValue>
      <MoveSpeed>2.0</MoveSpeed>
      <!-- 等效射击 16。 -->
      <ShootingAccuracyPawn>8</ShootingAccuracyPawn>
    </statBases>
    <race>
      <baseHealthScale>2.8</baseHealthScale>
      <mechWeightClass>UltraHeavy</mechWeightClass>
    </race>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_Beelzebub</defName>
    <label>贝尔泽布布淳平</label>
    <race>Mech_ChunPing_Beelzebub</race>
    <isFighter>true</isFighter>
    <combatPower>560</combatPower>
    <weaponTags>
      <li>MechanoidGunMedium</li>
    </weaponTags>
  </PawnKindDef>


  <!-- 魔王炮、蓄力、部署和 AOE 留待后续；当前使用原版远程武器标签。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_DemonKing</defName>
    <label>魔王淳平</label>
    <description>超重型远程炮台。特殊炮击模式、蓄力和范围攻击暂未实现。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.3</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
      <MarketValue>5200</MarketValue>
      <MoveSpeed>1.7</MoveSpeed>
      <!-- 等效射击 20。 -->
      <ShootingAccuracyPawn>12</ShootingAccuracyPawn>
    </statBases>
    <race>
      <baseHealthScale>3.2</baseHealthScale>
      <mechWeightClass>UltraHeavy</mechWeightClass>
    </race>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_DemonKing</defName>
    <label>魔王淳平</label>
    <race>Mech_ChunPing_DemonKing</race>
    <isFighter>true</isFighter>
    <combatPower>620</combatPower>
    <weaponTags>
      <li>MechanoidGunLongRange</li>
    </weaponTags>
  </PawnKindDef>
</Defs>
