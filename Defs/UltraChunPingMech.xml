  <!-- 贝尔泽布布释放的自主近战机械体，定位参考原版战争小镰。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Tokugawa</defName>
    <label>德川机械体</label>
    <description>由贝尔泽布布淳平释放的轻型自主近战机械体，速度快但生存能力有限。</description>
    <statBases>
      <BandwidthCost>0</BandwidthCost>
      <MarketValue>180</MarketValue>
      <MoveSpeed>5.4</MoveSpeed>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <MeleeHitChance>8</MeleeHitChance>
    </statBases>
    <tools>
      <li>
        <label>德川切割器</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
    </tools>
    <race>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.42</baseHealthScale>
      <mechWeightClass>Light</mechWeightClass>
      <thinkTreeConstant>WarUrchinConstant</thinkTreeConstant>
      <hasCorpse>false</hasCorpse>
    </race>
    <comps>
      <li Class="ChunPingMech.CompProperties_SummonedLifetime">
        <compClass>ChunPingMech.CompSummonedLifetime</compClass>
        <lifespanTicks>7200</lifespanTicks>
      </li>
    </comps>
  </ThingDef>

