<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 标准科技单位。特殊技能、处决、自爆和控制效果均留待后续阶段。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Doctor</defName>
    <label>大医生淳平</label>
    <description>执行医疗和科研工作的专业机械体。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <MarketValue>1400</MarketValue>
      <MoveSpeed>4.2</MoveSpeed>
    </statBases>
    <race>
      <mechWeightClass>Medium</mechWeightClass>
      <!-- 同时作用于医疗与研究；以主职医疗 20 为准。 -->
      <mechFixedSkillLevel>20</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Doctor</li>
        <li>Research</li>
      </mechEnabledWorkTypes>
    </race>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_Doctor</defName>
    <label>大医生淳平</label>
    <race>Mech_ChunPing_Doctor</race>
    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Fabricor</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/FabricorAncient</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>


  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Bully_ballBat</defName>
    <label>恶霸淳平(棒球棍)</label>
    <description>装备棒球棍的中型战斗机械体，拥有较强的近战能力。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.8</ArmorRating_Blunt>
      <MarketValue>1700</MarketValue>
      <MoveSpeed>3.2</MoveSpeed>
      <MeleeHitChance>12</MeleeHitChance>
      <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
    </statBases>
    <tools>
      <li>
        <label>heavy fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <race>
      <baseHealthScale>1.25</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
    </race>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_Bully_ballBat</defName>
