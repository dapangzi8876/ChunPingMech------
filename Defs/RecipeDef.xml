<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 配方父类直接继承 Biotech 原版培育配方，确保培育周期、机械师限制和工作量正确。 -->


  <RecipeDef Name="ChunPingBasicRecipe" ParentName="LightMechanoidRecipe" Abstract="True">
    <researchPrerequisite>ChunPing_BasicMechtech</researchPrerequisite>
    <displayPriority>100</displayPriority>
  </RecipeDef>


  <RecipeDef Name="ChunPingStandardRecipe" ParentName="MediumMechanoidRecipe" Abstract="True">
    <researchPrerequisite>ChunPing_StandardMechtech</researchPrerequisite>
    <displayPriority>200</displayPriority>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreRegular</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
  </RecipeDef>


