    <RecipeDef ParentName="LightMechanoidRecipe">
        <defName>Gestate_ChunPing_Calligrapher</defName>
        <label>孕育书法家淳平</label>
        <description>
            孕育一台书法家淳平机械体。
            该型号以淳平的书法家造型为模板，专门用于艺术创作。
        </description>

        <researchPrerequisite>HighMechtech</researchPrerequisite>

        <ingredients Inherit="False">
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>100</count>
            </li>

            <li>
                <filter>
                    <thingDefs>
                        <li>SubcoreHigh</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
        </ingredients>

        <products>
            <Mech_ChunPing_Calligrapher>1</Mech_ChunPing_Calligrapher>
        </products>

        <descriptionHyperlinks>
            <ThingDef>Mech_ChunPing_Calligrapher</ThingDef>
        </descriptionHyperlinks>

    </RecipeDef>


