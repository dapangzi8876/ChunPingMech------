  <ThingDef Name="ChunPingMechBase" ParentName="LightMechanoid" Abstract="True">
    <statBases>
      <MarketValue>850</MarketValue>
      <BandwidthCost>1</BandwidthCost>
      <MoveSpeed>3.4</MoveSpeed>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <CarryingCapacity>75</CarryingCapacity>
      <EMPResistance>0.1</EMPResistance>
      <WorkSpeedGlobal>1</WorkSpeedGlobal>
    </statBases>
    <race>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Fabricor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Fabricor_Death</soundDeath>
          <soundCall>Pawn_Mech_Fabricor_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Fabricor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Fabricor_Death</soundDeath>
          <soundCall>Pawn_Mech_Fabricor_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <!-- TODO: 用正式淳平贴图/音效替换以下原版占位资源。 -->
  </ThingDef>


  <PawnKindDef Name="ChunPingMechBaseKind" ParentName="NonCombatLightMechanoidKind" Abstract="True">
