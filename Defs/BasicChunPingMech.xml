    <ThingDef ParentName="ChunPingMechBase">
        <defName>Mech_ChunPing_Waiter</defName>
        <label>服务员淳平</label>
        <description>
            以淳平在会员制餐厅中的服务员形象为基础制造的综合服务机械体。
            黑色背心、领结和略显拘谨的服务姿态成为这一型号最醒目的识别特征。
            它擅长处理餐饮、清洁以及殖民地中的各种基础服务工作，
            并会一丝不苟地维持工作区域的整洁。
        </description>

        <!-- <statBases> -->
        <!--     做饭机械体应尽可能避免食物中毒 -->
        <!--     <FoodPoisonChance>0.001</FoodPoisonChance> -->
        <!-- </statBases> -->
        <race>
            <mechEnabledWorkTypes>
                <!-- 暂时把“照料/杂务服务”理解成 Basic -->
                <li>BasicWorker</li>
                <li>Cooking</li>
                <li>Cleaning</li>
            </mechEnabledWorkTypes>
        </race>
    </ThingDef>

