  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_SnowSamurai</defName>
    <label>雪之武士淳平</label>
    <description>高速、高伤害但较脆弱的近战刺客。能够隐身、使用雪之呼吸，并处决濒死敌人。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.9</ArmorRating_Blunt>
      <MarketValue>2600</MarketValue>
      <MoveSpeed>5.4</MoveSpeed>
      <MeleeHitChance>16</MeleeHitChance>
    </statBases>
    <tools>
      <li>
        <label>samurai blade</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>32</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
    </tools>
    <race>
      <baseHealthScale>0.90</baseHealthScale>
