<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 高级科技单位。贴图仍统一使用 Fabricor 占位。 -->
  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_WasedaHero</defName>
    <label>早稻田英雄淳平</label>
    <description>耐久较高的支援型机械体。能够瞬移救援友军、治愈伤口、转移伤势，并用早稻田精神鼓舞全场。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
      <MarketValue>2400</MarketValue>
      <MoveSpeed>3.8</MoveSpeed>
      <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
    </statBases>
    <race>
      <baseHealthScale>1.45</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <mechFixedSkillLevel>14</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Doctor</li>
      <li>BasicWorker</li>
      </mechEnabledWorkTypes>
    </race>
    <abilities>
      <li>ChunPing_Ability_HeroRescue</li>
      <li>ChunPing_Ability_HeroHeal</li>
      <li>ChunPing_Ability_DamageTransfer</li>
      <li>ChunPing_Ability_WasedaSpirit</li>
    </abilities>
    <comps>
      <li Class="ChunPingMech.CompProperties_WasedaHeroPassive">
        <compClass>ChunPingMech.CompWasedaHeroPassive</compClass>
        <lastStandHediff>ChunPing_HeroLastStand</lastStandHediff>
        <deathTriggerHediff>ChunPing_HeroDeathTrigger</deathTriggerHediff>
        <criticalHealthThreshold>0.3</criticalHealthThreshold>
      </li>
    </comps>
  </ThingDef>


  <PawnKindDef ParentName="ChunPingMechBaseKind">
    <defName>Mech_ChunPing_WasedaHero</defName>
    <label>早稻田英雄淳平</label>
    <race>Mech_ChunPing_WasedaHero</race>
    <lifeStages Inherit="False">
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/Fabricor</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/FabricorAncient</texPath>
          <maskPath>Things/Pawn/Mechanoid/AllegianceOverlays/Mech_Fabricor</maskPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <isFighter>true</isFighter>
    <combatPower>260</combatPower>
    <weaponTags>
      <li>MechanoidGunShortRange</li>
    </weaponTags>
  </PawnKindDef>


  <ThingDef ParentName="ChunPingMechBase">
    <defName>Mech_ChunPing_Hulk</defName>
    <label>绿巨人淳平</label>
    <description>高生命、高护甲并拥有较高载重能力的重型坦克机械体。</description>
    <statBases>
      <BandwidthCost>1</BandwidthCost>
      <ArmorRating_Sharp>1.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt>
      <MarketValue>3000</MarketValue>
      <MoveSpeed>2.2</MoveSpeed>
      <CarryingCapacity>1200</CarryingCapacity>
      <EnergyShieldRechargeRate>0.12</EnergyShieldRechargeRate>
      <EnergyShieldEnergyMax>2.4</EnergyShieldEnergyMax>
      <EMPResistance>0.45</EMPResistance>
      <!-- 等效近战 14。 -->
      <MeleeHitChance>12</MeleeHitChance>
    </statBases>
    <tools>
      <li>
        <label>heavy fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2.7</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <race>
      <baseBodySize>1.5</baseBodySize>
      <baseHealthScale>2.2</baseHealthScale>
      <mechWeightClass>Heavy</mechWeightClass>
    </race>
    <comps>
      <li Class="CompProperties_ProjectileInterceptor">
        <radius>4</radius>
        <interceptGroundProjectiles>true</interceptGroundProjectiles>
        <color>(0.4, 0.4, 0.4)</color>
        <reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect>
        <activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>280</hitPoints>
        <hitPointsRestoreInstantlyAfterCharge>true</hitPointsRestoreInstantlyAfterCharge>
        <chargeDurationTicks>9000</chargeDurationTicks>
        <drawWithNoSelection>True</drawWithNoSelection>
        <disarmedByEmpForTicks>3000</disarmedByEmpForTicks>
        <gizmoTipKey>ProjectileInterceptorTip</gizmoTipKey>
      </li>
    </comps>
  </ThingDef>


